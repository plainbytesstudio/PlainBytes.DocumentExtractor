<UserControl
    x:Class="PlainBytes.Core.Controls.RateReviewToastBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:PlainBytes.Core.Resources"
    Width="360"
    Height="116"
    FontFamily="{DynamicResource PB.Fonts.Main}"
    Visibility="Collapsed">

    <UserControl.Resources>
        <Style
            x:Key="RateToastCloseButtonStyle"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="Foreground" Value="#1F2937" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="RatePrimaryButtonStyle"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Width" Value="76" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Appearance" Value="Primary" />
            <Setter Property="Background" Value="#1677FF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1464D9" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="RateTextButtonStyle"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="#334155" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border
        Padding="16"
        Background="#FFFFFF"
        BorderBrush="#D9E2F0"
        BorderThickness="1"
        CornerRadius="10"
        SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="20"
                Direction="270"
                Opacity="0.10"
                ShadowDepth="6"
                Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="36"
                    Height="36"
                    VerticalAlignment="Top"
                    Background="#E8F1FF"
                    CornerRadius="18">
                    <ui:SymbolIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Filled="True"
                        FontSize="18"
                        Foreground="#1677FF"
                        Symbol="Star24" />
                </Border>

                <StackPanel
                    Grid.Column="1"
                    Margin="12,1,8,0"
                    VerticalAlignment="Top">
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#1F2937"
                        Text="{x:Static res:Strings.Rate_Title}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="#64748B"
                        Text="{x:Static res:Strings.Rate_Description}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <ui:Button
                    Grid.Column="2"
                    VerticalAlignment="Top"
                    Style="{StaticResource RateToastCloseButtonStyle}"
                    Icon="{ui:SymbolIcon Symbol=Dismiss24, FontSize=12}"
                    Click="Close_Click" />
            </Grid>

            <Grid
                Grid.Row="1"
                Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal">
                <ui:Button
                    Style="{StaticResource RatePrimaryButtonStyle}"
                    Content="{x:Static res:Strings.Rate_Action}"
                    Click="Rate_Click" />
                <ui:Button
                    Margin="8,0,0,0"
                    Style="{StaticResource RateTextButtonStyle}"
                    Content="{x:Static res:Strings.Rate_Never}"
                    Click="Never_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
