<ui:FluentWindow
    x:Class="PlainBytes.Core.Controls.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:PlainBytes.Core.Resources"
    Title="{x:Static res:Strings.App_Title}"
    Width="1100"
    Height="640"
    MinWidth="1100"
    MinHeight="640"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    Icon="pack://application:,,,/PlainBytes.Core;component/Assets/Icons/Application.ico"
    Background="#F7F9FC"
    Foreground="#172033"
    FontFamily="Segoe UI, Microsoft YaHei"
    TextOptions.TextFormattingMode="Display"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="#172033">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlainBytes.Core;component/Themes/SharedResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Sidebar + content: columns mirror for Arabic RTL (rail on right); TitleBar stays LTR -->
        <Grid
            x:Name="ShellBody"
            Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

        <!-- NavigationRail: fixed 48px width, icon + ToolTip only -->
        <Border
            x:Name="NavigationRail"
            Grid.Column="0"
            Width="48"
            Margin="0,0,0,0"
            Background="#F9FAFE"
            BorderBrush="{StaticResource PB.Brushes.Border}"
            BorderThickness="0,0,1,0"
            SnapsToDevicePixels="True">
            <Grid Background="Transparent" Margin="0,40,0,12">
                <!-- Top section: populated by each tool via ConfigureTopNavigation -->
                <StackPanel
                    x:Name="TopNavHost"
                    VerticalAlignment="Top" />
                <StackPanel VerticalAlignment="Bottom">
                    <!-- TEMP: language switch (debug) — hidden in release builds -->
                    <Grid Width="48" Height="48" Background="Transparent" Visibility="Collapsed">
                        <ui:Button
                            x:Name="LanguageNavButton"
                            Style="{StaticResource NavigationRailButtonStyle}"
                            ToolTip="Language / 语言"
                            Click="LanguageNavButton_Click">
                            <ui:SymbolIcon
                                FontSize="20"
                                Foreground="{StaticResource PB.Brushes.TextPrimary}"
                                Symbol="LocalLanguage24" />
                        </ui:Button>
                    </Grid>
                    <Grid Width="48" Height="48" Background="Transparent">
                        <Border
                            x:Name="MatrixNavIndicator"
                            Width="3"
                            Height="16"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="4,0,0,0"
                            Background="{StaticResource PB.Brushes.Primary}"
                            CornerRadius="2"
                            Visibility="Collapsed" />
                        <ui:Button
                            x:Name="MatrixNavButton"
                            Style="{StaticResource NavigationRailButtonStyle}"
                            ToolTip="{x:Static res:Strings.Nav_Matrix}"
                            Click="MatrixNavButton_Click">
                            <Image
                                Width="20"
                                Height="20"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                SnapsToDevicePixels="True"
                                Source="pack://application:,,,/PlainBytes.Core;component/Assets/Images/collection-w.png" />
                        </ui:Button>
                    </Grid>
                    <Grid Width="48" Height="48" Background="Transparent" Visibility="Collapsed">
                        <Border
                            x:Name="SupportNavIndicator"
                            Width="3"
                            Height="16"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="4,0,0,0"
                            Background="{StaticResource PB.Brushes.Primary}"
                            CornerRadius="2"
                            Visibility="Collapsed" />
                        <ui:Button
                            x:Name="SupportNavButton"
                            Style="{StaticResource NavigationRailButtonStyle}"
                            ToolTip="{x:Static res:Strings.Nav_Support}"
                            Click="SupportNavButton_Click">
                            <Image
                                Width="20"
                                Height="20"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                SnapsToDevicePixels="True"
                                Source="pack://application:,,,/PlainBytes.Core;component/Assets/Images/cup-w.png" />
                        </ui:Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content: light fill for readability; Wpf.Ui theme falls back on Win10 -->
        <Border
            Grid.Column="1"
            Background="{DynamicResource ControlFillColorDefaultBrush}">
            <ContentControl
                x:Name="ContentArea"
                Background="Transparent"
                Margin="38,42,38,16"
                Focusable="False"
                IsTabStop="False"
                FocusVisualStyle="{x:Null}" />
        </Border>
        </Grid>

        <!-- Top-right rate toast: 72px from top, 24px from right; anchored to window chrome, not mirrored in RTL -->
        <ContentControl
            x:Name="TopToastHost"
            Grid.Row="0"
            Grid.RowSpan="2"
            Width="360"
            Margin="0,72,24,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Top"
            Panel.ZIndex="150"
            Visibility="Collapsed" />

        <!-- TitleBar: product name SemiBold; window button area 138px (46×3) -->
        <Border
            Grid.Row="0"
            BorderBrush="{StaticResource PB.Brushes.Border}"
            BorderThickness="0,0,1,0"
            SnapsToDevicePixels="True">
            <ui:TitleBar
                x:Name="AppTitleBar"
                FlowDirection="LeftToRight"
                Height="48"
                Padding="8,0,0,0"
                FontSize="16"
                FontWeight="SemiBold"
                Background="#F7F8FD"
                Foreground="{StaticResource PB.Brushes.TextPrimary}"
                ButtonsForeground="{StaticResource PB.Brushes.TextPrimary}"
                Title="{x:Static res:Strings.App_Title}"
                ShowClose="True"
                ShowMaximize="True"
                ShowMinimize="True">
                <!-- Logo 32×32 + 12px gap before title; header text set in code for SetToolName -->
                <ui:TitleBar.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image
                            x:Name="TitleBarIcon"
                            Width="32"
                            Height="32"
                            Margin="0,0,12,0"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            SnapsToDevicePixels="True"
                            Source="pack://application:,,,/PlainBytes.Core;component/Assets/Images/Application72.png" />
                        <TextBlock
                            x:Name="TitleTextBlock"
                            VerticalAlignment="Center"
                            FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ui:TitleBar}}"
                            FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ui:TitleBar}}"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:TitleBar}}" />
                        <ui:Button
                            x:Name="EditionBadgeButton"
                            Margin="8,0,0,0"
                            Padding="8,2"
                            MinHeight="0"
                            Height="24"
                            VerticalAlignment="Center"
                            Appearance="Secondary"
                            Background="#EEF2FF"
                            BorderBrush="#C7D2FE"
                            BorderThickness="1"
                            CornerRadius="4"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#4338CA"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Click="EditionBadgeButton_Click" />
                    </StackPanel>
                </ui:TitleBar.Header>
            </ui:TitleBar>
        </Border>

        <!-- Full-window overlay host (progress, purchase dialogs, etc.).
             Background must be non-null or hits pass through to TitleBar / content. -->
        <ContentControl
            x:Name="OverlayHost"
            Grid.Row="0"
            Grid.RowSpan="2"
            Panel.ZIndex="200"
            Background="#01000000"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Focusable="False"
            IsTabStop="False"
            FocusVisualStyle="{x:Null}"
            Visibility="Collapsed" />
    </Grid>
</ui:FluentWindow>
