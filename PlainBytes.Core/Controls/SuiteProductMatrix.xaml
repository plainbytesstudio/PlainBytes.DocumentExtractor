<UserControl
    x:Class="PlainBytes.Core.Controls.SuiteProductMatrix"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:PlainBytes.Core.Resources"
    d:DesignHeight="240"
    d:DesignWidth="1000"
    FontFamily="{DynamicResource PB.Fonts.Main}"
    mc:Ignorable="d">

    <ItemsControl x:Name="ProductList">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <!-- Card 380px wide + 16px right margin; WrapPanel MaxWidth 1680 caps row width -->
                <WrapPanel
                    MaxWidth="1680"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <!-- Card fixed 380×112; description area three lines tall, top-aligned -->
                <Border
                    Width="380"
                    Height="112"
                    Margin="0,0,16,12"
                    Padding="18"
                    CornerRadius="12"
                    Cursor="Hand"
                    SnapsToDevicePixels="True"
                    MouseLeftButtonUp="ProductCard_MouseLeftButtonUp">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#F8FAFC" />
                            <Setter Property="BorderBrush" Value="#EEF2F7" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F1F5F9" />
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Grid.Column="0"
                            Width="40"
                            Height="40"
                            Margin="0,0,12,0"
                            VerticalAlignment="Top"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="{Binding IconPath}" />

                        <StackPanel
                            Grid.Column="1"
                            Margin="0,0,12,0"
                            VerticalAlignment="Top">
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="#0F172A"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <TextBlock
                                Height="40"
                                Margin="0,4,0,0"
                                FontSize="12"
                                FontWeight="Normal"
                                LineHeight="18"
                                LineStackingStrategy="BlockLineHeight"
                                Foreground="#94A3B8"
                                Text="{Binding Description}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Installed badge -->
                        <Border
                            Grid.Column="2"
                            Padding="8,3"
                            VerticalAlignment="Top"
                            Background="#F0FDF4"
                            CornerRadius="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#16A34A"
                                Text="{x:Static res:Strings.Matrix_Installed}" />
                        </Border>

                        <!-- Learn more link (hidden when installed) -->
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Top"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#475569"
                            Text="{x:Static res:Strings.Matrix_LearnMore}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
