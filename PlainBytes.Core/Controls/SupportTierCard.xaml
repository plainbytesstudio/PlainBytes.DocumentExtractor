<UserControl
    x:Class="PlainBytes.Core.Controls.SupportTierCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:PlainBytes.Core.Resources"
    Width="250"
    Height="430"
    Margin="0,0,16,16"
    FontFamily="{DynamicResource PB.Fonts.Main}">

    <UserControl.Resources>
        <Style
            x:Key="TierOutlineButtonStyle"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#2563EB" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF" />
                    <Setter Property="BorderBrush" Value="#2563EB" />
                    <Setter Property="Foreground" Value="#2563EB" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="TierPrimaryButtonStyle"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Appearance" Value="Primary" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8" />
                    <Setter Property="BorderBrush" Value="#1D4ED8" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border
        x:Name="CardRoot"
        Background="#FFFFFF"
        BorderBrush="#E2E8F0"
        BorderThickness="1"
        CornerRadius="14"
        Cursor="Hand"
        SnapsToDevicePixels="True"
        MouseEnter="CardRoot_MouseEnter"
        MouseLeave="CardRoot_MouseLeave">
        <Border.Effect>
            <DropShadowEffect
                x:Name="CardShadow"
                BlurRadius="12"
                Direction="270"
                Opacity="0"
                ShadowDepth="2"
                Color="#0F172A" />
        </Border.Effect>

        <Grid>
            <!-- Popular badge: top-right inside card border -->
            <Border
                x:Name="PopularTag"
                Width="72"
                Height="28"
                Margin="0,12,14,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#EFF6FF"
                CornerRadius="14"
                Visibility="Collapsed"
                Panel.ZIndex="1">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="#2563EB"
                        Text="★" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#2563EB"
                        Text="{x:Static res:Strings.Support_Popular}" />
                </StackPanel>
            </Border>

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Stretch">
                    <Border
                        x:Name="IconBackdrop"
                        Width="80"
                        Height="80"
                        HorizontalAlignment="Center"
                        CornerRadius="40"
                        Background="#FFF7ED">
                        <Image
                            x:Name="IconImage"
                            Width="56"
                            Height="56"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            SnapsToDevicePixels="True" />
                    </Border>

                    <TextBlock
                        x:Name="TitleText"
                        Margin="0,14,0,0"
                        FontSize="21"
                        FontWeight="SemiBold"
                        LineHeight="26"
                        LineStackingStrategy="BlockLineHeight"
                        Foreground="#172033"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <TextBlock
                        x:Name="DescriptionText"
                        Margin="0,12,0,0"
                        FontSize="13"
                        Foreground="#64748B"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <TextBlock
                        x:Name="PriceText"
                        Margin="0,24,0,0"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="#172033"
                        TextAlignment="Center" />

                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="13"
                        Foreground="#64748B"
                        Text="{x:Static res:Strings.Support_Once}"
                        TextAlignment="Center" />
                </StackPanel>

                <ui:Button
                    x:Name="SupportButton"
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    Content="{x:Static res:Strings.Support_Button}"
                    Style="{StaticResource TierOutlineButtonStyle}"
                    Click="SupportButton_Click" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
