<UserControl
    x:Class="PlainBytes.DocumentExtractor.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:PlainBytes.DocumentExtractor.Resources"
    d:DesignHeight="560"
    d:DesignWidth="800"
    FontFamily="{DynamicResource PB.Fonts.Main}"
    Foreground="{DynamicResource PB.Brushes.TextPrimary}"
    mc:Ignorable="d">

    <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            FocusVisualStyle="{x:Null}"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <StackPanel
                    Margin="0,0,0,28"
                    HorizontalAlignment="Stretch"
                    Orientation="Horizontal">
                    <Image
                        Width="40"
                        Height="40"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        SnapsToDevicePixels="True"
                        Source="pack://application:,,,/PlainBytes.Core;component/Assets/Images/about-us.png" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="30"
                            FontWeight="SemiBold"
                            LineHeight="40"
                            LineStackingStrategy="BlockLineHeight"
                            Foreground="{DynamicResource PB.Brushes.TextPrimary}"
                            Text="{x:Static res:Strings.About_Title}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="15"
                            FontWeight="Normal"
                            LineHeight="24"
                            LineStackingStrategy="BlockLineHeight"
                            Foreground="{DynamicResource PB.Brushes.TextSecondary}"
                            Text="{x:Static res:Strings.About_Subtitle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <!-- 产品信息：左对齐，可用宽度内最多 815（Stretch+MaxWidth 会居中） -->
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="815" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Height="120"
                        Padding="20"
                        Background="#F8FAFC"
                        BorderBrush="#EEF2F7"
                        BorderThickness="1"
                        CornerRadius="12"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Image
                                Grid.Column="0"
                                Width="64"
                                Height="64"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                SnapsToDevicePixels="True"
                                Source="pack://application:,,,/PlainBytes.Core;component/Assets/Images/logo_DocumentExtracto.png" />

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="#0F172A"
                                    Text="{x:Static res:Strings.About_ProductName}" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    FontSize="14"
                                    FontWeight="Normal"
                                    Foreground="#64748B"
                                    Text="{x:Static res:Strings.About_ProductTagline}" />
                                <DockPanel LastChildFill="False" Margin="0,8,0,0" HorizontalAlignment="Left">
                                    <Border
                                        Padding="8,3"
                                        DockPanel.Dock="Left"
                                        Background="#F1F5F9"
                                        CornerRadius="5">
                                        <TextBlock
                                            x:Name="AboutVersionText"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#64748B"
                                            Text="" />
                                    </Border>
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel Margin="0,20,0,0" MaxWidth="780" HorizontalAlignment="Left">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Normal"
                        LineHeight="23"
                        LineStackingStrategy="BlockLineHeight"
                        Foreground="#64748B"
                        Text="{x:Static res:Strings.About_LicenseNotice}" />
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#475569"
                            Cursor="Hand"
                            Text="{x:Static res:Strings.About_SourceCode}"
                            MouseLeftButtonUp="SourceCode_Click">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#0F172A" />
                                            <Setter Property="TextDecorations" Value="Underline" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock
                            Margin="20,0,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#475569"
                            Cursor="Hand"
                            Text="{x:Static res:Strings.About_LicenseLink}"
                            MouseLeftButtonUp="LicenseLink_Click">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#0F172A" />
                                            <Setter Property="TextDecorations" Value="Underline" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,30,0,0" MaxWidth="780" HorizontalAlignment="Left">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#0F172A"
                        Text="{x:Static res:Strings.About_SectionTitle}" />
                    <TextBlock
                        Margin="0,12,0,0"
                        FontSize="14"
                        FontWeight="Normal"
                        LineHeight="23"
                        LineStackingStrategy="BlockLineHeight"
                        Foreground="#64748B"
                        TextWrapping="Wrap"
                        Text="{x:Static res:Strings.About_Body}" />
                </StackPanel>

                <!-- Custom Development -->
                <StackPanel Margin="0,30,0,8" MaxWidth="780" HorizontalAlignment="Left">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#0F172A"
                        Text="{x:Static res:Strings.About_CustomDev_Title}" />
                    <TextBlock
                        Margin="0,12,0,0"
                        FontSize="14"
                        FontWeight="Normal"
                        LineHeight="23"
                        LineStackingStrategy="BlockLineHeight"
                        Foreground="#64748B"
                        TextWrapping="Wrap"
                        Text="{x:Static res:Strings.About_CustomDev_Intro}" />

                    <StackPanel Margin="0,14,0,0">
                        <DockPanel LastChildFill="True" Margin="0,0,0,8">
                            <TextBlock
                                DockPanel.Dock="Left"
                                Margin="0,1,8,0"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#93C5FD"
                                Text="✓" />
                            <TextBlock
                                FontSize="14"
                                FontWeight="Normal"
                                LineHeight="23"
                                LineStackingStrategy="BlockLineHeight"
                                Foreground="#64748B"
                                TextWrapping="Wrap"
                                Text="{x:Static res:Strings.About_CustomDev_Simple}" />
                        </DockPanel>
                        <DockPanel LastChildFill="True">
                            <TextBlock
                                DockPanel.Dock="Left"
                                Margin="0,1,8,0"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#93C5FD"
                                Text="✓" />
                            <TextBlock
                                FontSize="14"
                                FontWeight="Normal"
                                LineHeight="23"
                                LineStackingStrategy="BlockLineHeight"
                                Foreground="#64748B"
                                TextWrapping="Wrap"
                                Text="{x:Static res:Strings.About_CustomDev_Custom}" />
                        </DockPanel>
                    </StackPanel>

                    <TextBlock
                        Margin="0,14,0,0"
                        FontSize="14"
                        FontWeight="Normal"
                        LineHeight="23"
                        LineStackingStrategy="BlockLineHeight"
                        Foreground="#64748B"
                        TextWrapping="Wrap"
                        Text="{x:Static res:Strings.About_CustomDev_Pricing}" />

                    <TextBlock
                        Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#2563EB"
                        Cursor="Hand"
                        Text="{x:Static res:Strings.About_CustomDev_Contact}"
                        MouseLeftButtonUp="ContactUs_Click" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <DockPanel
            Grid.Row="1"
            Margin="0,24,0,30"
            LastChildFill="False">
            <StackPanel
                MaxWidth="815"
                HorizontalAlignment="Stretch"
                DockPanel.Dock="Left">
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="#0F172A"
                    Text="{x:Static res:Strings.About_MoreTools}" />
                <StackPanel
                    Margin="0,14,0,0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <ItemsControl x:Name="MoreToolsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel
                                    Margin="0,0,28,0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                                    <Image
                                        Width="32"
                                        Height="32"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        Source="{Binding IconPath}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="Normal"
                                        Foreground="#0F172A"
                                        Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#475569"
                        Cursor="Hand"
                        Text="{x:Static res:Strings.About_ViewAll}"
                        MouseLeftButtonUp="ViewAllTools_Click">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#0F172A" />
                                        <Setter Property="TextDecorations" Value="Underline" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <DockPanel
            Grid.Row="2"
            LastChildFill="False">
            <TextBlock
                DockPanel.Dock="Left"
                FontSize="12"
                FontWeight="Normal"
                Foreground="#94A3B8"
                Text="{x:Static res:Strings.About_Copyright}" />
        </DockPanel>
    </Grid>
</UserControl>
