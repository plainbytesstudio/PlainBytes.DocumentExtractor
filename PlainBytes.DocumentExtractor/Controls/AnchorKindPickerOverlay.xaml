<UserControl
    x:Class="PlainBytes.DocumentExtractor.Controls.AnchorKindPickerOverlay"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:PlainBytes.DocumentExtractor.Resources"
    FontFamily="{DynamicResource PB.Fonts.Main}"
    Focusable="True"
    FocusVisualStyle="{x:Null}"
    PreviewKeyDown="Root_PreviewKeyDown">

    <Grid Background="Transparent">
        <Border Background="#990F172A" />

        <Border
            Width="420"
            MaxWidth="420"
            Padding="28,28,28,24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="10"
            SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="24"
                    Direction="270"
                    Opacity="0.16"
                    ShadowDepth="8"
                    Color="#000000" />
            </Border.Effect>

            <StackPanel>
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="#172033"
                    Text="{x:Static res:Strings.AnchorKind_PickerTitle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,10,0,0"
                    FontSize="14"
                    LineHeight="22"
                    LineStackingStrategy="BlockLineHeight"
                    Foreground="#64748B"
                    Text="{x:Static res:Strings.AnchorKind_PickerMessage}"
                    TextWrapping="Wrap" />

                <StackPanel Margin="0,22,0,0">
                    <ui:Button
                        x:Name="ValueButton"
                        Height="44"
                        Margin="0,0,0,8"
                        Padding="14,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Appearance="Secondary"
                        Background="#FFFFFF"
                        BorderBrush="#2563EB"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Cursor="Hand"
                        FocusVisualStyle="{x:Null}"
                        Click="ValueButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,10,0"
                                FontSize="18"
                                Foreground="#2563EB"
                                Symbol="TextBulletListLtr24"
                                VerticalAlignment="Center" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#172033"
                                Text="{x:Static res:Strings.AnchorKind_Value}" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button
                        x:Name="TableButton"
                        Height="44"
                        Padding="14,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Appearance="Secondary"
                        Background="#FFFFFF"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Cursor="Hand"
                        FocusVisualStyle="{x:Null}"
                        Click="TableButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,10,0"
                                FontSize="18"
                                Foreground="#64748B"
                                Symbol="Table24"
                                VerticalAlignment="Center" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#172033"
                                Text="{x:Static res:Strings.AnchorKind_Table}" />
                        </StackPanel>
                    </ui:Button>

                    <StackPanel
                        x:Name="TableColumnPanel"
                        Margin="0,12,0,0"
                        Visibility="Collapsed">
                        <TextBlock
                            FontSize="13"
                            Foreground="#64748B"
                            Text="{x:Static res:Strings.AnchorKind_ColumnCountLabel}"
                            TextWrapping="Wrap" />
                        <ui:NumberBox
                            x:Name="ColumnCountBox"
                            Margin="0,8,0,0"
                            Minimum="2"
                            Maximum="30"
                            SpinButtonPlacementMode="Inline"
                            ClearButtonEnabled="False" />
                        <ui:Button
                            Margin="0,12,0,0"
                            Height="40"
                            HorizontalAlignment="Stretch"
                            Appearance="Primary"
                            Background="#2563EB"
                            BorderBrush="#2563EB"
                            CornerRadius="8"
                            FontSize="14"
                            Cursor="Hand"
                            Content="{x:Static res:Strings.AnchorKind_ConfirmTable}"
                            Click="ConfirmTableButton_Click" />
                    </StackPanel>
                </StackPanel>

                <ui:Button
                    Margin="0,20,0,0"
                    Height="36"
                    MinWidth="100"
                    Padding="16,0"
                    HorizontalAlignment="Right"
                    Appearance="Secondary"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="6"
                    FontSize="14"
                    Foreground="#64748B"
                    Cursor="Hand"
                    Content="{x:Static res:Strings.Dialog_Cancel}"
                    Click="CancelButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
