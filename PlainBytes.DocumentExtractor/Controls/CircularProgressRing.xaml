<UserControl
    x:Class="PlainBytes.DocumentExtractor.Controls.CircularProgressRing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="32"
    Height="32">
    <Grid>
        <Ellipse
            x:Name="Track"
            Stroke="#E8F1FF"
            StrokeThickness="3"
            Fill="Transparent" />
        <Path
            x:Name="ProgressArc"
            Stroke="#1677FF"
            StrokeThickness="3"
            StrokeStartLineCap="Round"
            StrokeEndLineCap="Round"
            Fill="Transparent" />
    </Grid>
</UserControl>
