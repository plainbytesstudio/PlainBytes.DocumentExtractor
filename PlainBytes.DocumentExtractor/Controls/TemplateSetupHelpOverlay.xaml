<UserControl
    x:Class="PlainBytes.DocumentExtractor.Controls.TemplateSetupHelpOverlay"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:PlainBytes.DocumentExtractor.Resources"
    FontFamily="{DynamicResource PB.Fonts.Main}"
    Focusable="True"
    FocusVisualStyle="{x:Null}"
    PreviewKeyDown="Root_PreviewKeyDown">

    <Grid Background="Transparent">
        <Border Background="#990F172A" />

        <Border
            Width="500"
            MaxWidth="500"
            Padding="28,28,28,24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#FFFFFF"
            BorderBrush="#EEF2F7"
            BorderThickness="1"
            CornerRadius="10"
            SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="24"
                    Direction="270"
                    Opacity="0.16"
                    ShadowDepth="8"
                    Color="#000000" />
            </Border.Effect>

            <StackPanel>
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="#0F172A"
                    Text="{x:Static res:Strings.Templates_SetupHelp_Title}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,14,0,0"
                    FontSize="14"
                    LineHeight="22"
                    LineStackingStrategy="BlockLineHeight"
                    Foreground="#0F172A"
                    Text="{x:Static res:Strings.Templates_SetupHelp_Lead}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,14,0,0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="#0F172A"
                    Text="{x:Static res:Strings.Templates_SetupHelp_EmailUs}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="14"
                    LineHeight="22"
                    LineStackingStrategy="BlockLineHeight"
                    Foreground="#475569"
                    Text="{x:Static res:Strings.Templates_SetupHelp_Item1}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="14"
                    LineHeight="22"
                    LineStackingStrategy="BlockLineHeight"
                    Foreground="#475569"
                    Text="{x:Static res:Strings.Templates_SetupHelp_Item2}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,14,0,0"
                    FontSize="14"
                    LineHeight="22"
                    LineStackingStrategy="BlockLineHeight"
                    Foreground="#475569"
                    Text="{x:Static res:Strings.Templates_SetupHelp_Promise}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,14,0,0"
                    FontSize="12"
                    LineHeight="18"
                    LineStackingStrategy="BlockLineHeight"
                    Foreground="#64748B"
                    Text="{x:Static res:Strings.Templates_SetupHelp_Privacy}"
                    TextWrapping="Wrap" />

                <StackPanel
                    Margin="0,28,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <ui:Button
                        MinWidth="100"
                        Height="36"
                        Margin="0,0,10,0"
                        Padding="16,0"
                        Appearance="Secondary"
                        Background="#FFFFFF"
                        BorderBrush="#EEF2F7"
                        BorderThickness="1"
                        CornerRadius="6"
                        FontSize="14"
                        Foreground="#0F172A"
                        Cursor="Hand"
                        Content="{x:Static res:Strings.Dialog_Cancel}"
                        Click="CancelButton_Click" />
                    <ui:Button
                        x:Name="ContactButton"
                        MinWidth="140"
                        Height="36"
                        Padding="16,0"
                        Appearance="Primary"
                        Background="#2563EB"
                        BorderBrush="#2563EB"
                        BorderThickness="1"
                        CornerRadius="6"
                        FontSize="14"
                        Foreground="#FFFFFF"
                        Cursor="Hand"
                        Content="{x:Static res:Strings.Templates_SetupHelp_Contact}"
                        Click="ContactButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
