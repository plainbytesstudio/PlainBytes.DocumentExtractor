<UserControl
    x:Class="PlainBytes.DocumentExtractor.Controls.UnsavedChangesOverlay"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:PlainBytes.DocumentExtractor.Resources"
    FontFamily="{DynamicResource PB.Fonts.Main}"
    Focusable="True"
    FocusVisualStyle="{x:Null}"
    PreviewKeyDown="Root_PreviewKeyDown">

    <Grid Background="Transparent">
        <Border Background="#990F172A" />

        <Border
            Width="460"
            MaxWidth="460"
            Padding="28,28,28,24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="10"
            SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="24"
                    Direction="270"
                    Opacity="0.16"
                    ShadowDepth="8"
                    Color="#000000" />
            </Border.Effect>

            <StackPanel>
                <TextBlock
                    x:Name="TitleText"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="#172033"
                    Text="{x:Static res:Strings.Unsaved_Title}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="MessageText"
                    Margin="0,12,0,0"
                    FontSize="14"
                    LineHeight="22"
                    LineStackingStrategy="BlockLineHeight"
                    Foreground="#64748B"
                    Text="{x:Static res:Strings.Unsaved_Message}"
                    TextWrapping="Wrap" />

                <StackPanel
                    Margin="0,28,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <ui:Button
                        MinWidth="100"
                        Height="36"
                        Margin="0,0,8,0"
                        Padding="14,0"
                        Appearance="Secondary"
                        Background="#FFFFFF"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="6"
                        FontSize="14"
                        Foreground="#64748B"
                        Cursor="Hand"
                        Content="{x:Static res:Strings.Dialog_Cancel}"
                        Click="CancelButton_Click" />
                    <ui:Button
                        MinWidth="110"
                        Height="36"
                        Margin="0,0,8,0"
                        Padding="14,0"
                        Appearance="Secondary"
                        Background="#FFFFFF"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="6"
                        FontSize="14"
                        Foreground="#172033"
                        Cursor="Hand"
                        Content="{x:Static res:Strings.Unsaved_Discard}"
                        Click="DiscardButton_Click" />
                    <ui:Button
                        x:Name="SaveButton"
                        MinWidth="110"
                        Height="36"
                        Padding="14,0"
                        Appearance="Primary"
                        Background="#2563EB"
                        BorderBrush="#2563EB"
                        BorderThickness="1"
                        CornerRadius="6"
                        FontSize="14"
                        Foreground="#FFFFFF"
                        Cursor="Hand"
                        Content="{x:Static res:Strings.Unsaved_Save}"
                        Click="SaveButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
