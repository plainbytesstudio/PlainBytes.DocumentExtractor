<UserControl
    x:Class="PlainBytes.DocumentExtractor.Help.HelpContentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:help="clr-namespace:PlainBytes.DocumentExtractor.Help"
    FontFamily="{DynamicResource PB.Fonts.Main}">

    <UserControl.Resources>
        <help:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />

        <DataTemplate x:Key="DescriptionTemplate" DataType="{x:Type help:HelpDescriptionBlock}">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="14"
                FontWeight="Normal"
                LineHeight="23"
                LineStackingStrategy="BlockLineHeight"
                Foreground="#64748B"
                Text="{Binding Text}"
                TextWrapping="Wrap" />
        </DataTemplate>

        <DataTemplate x:Key="HeadingTemplate" DataType="{x:Type help:HelpHeadingBlock}">
            <TextBlock
                Margin="0,8,0,10"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="#0F172A"
                Text="{Binding Text}"
                TextWrapping="Wrap" />
        </DataTemplate>

        <DataTemplate x:Key="StepsTemplate" DataType="{x:Type help:HelpStepsBlock}">
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="#0F172A"
                                Text="{Binding Title}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="14"
                                FontWeight="Normal"
                                LineHeight="23"
                                LineStackingStrategy="BlockLineHeight"
                                Foreground="#64748B"
                                Text="{Binding Body}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="CardsTemplate" DataType="{x:Type help:HelpCardsBlock}">
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,10"
                            Padding="14"
                            Background="#F8FAFC"
                            BorderThickness="0"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Image
                                    Grid.Column="0"
                                    Width="40"
                                    Height="40"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Top"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    Source="{Binding IconPath}"
                                    Visibility="{Binding IconPath, Converter={StaticResource NullOrEmptyToVisibility}}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="#0F172A"
                                        Text="{Binding Title}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="12"
                                        FontWeight="Normal"
                                        LineHeight="20"
                                        LineStackingStrategy="BlockLineHeight"
                                        Foreground="#94A3B8"
                                        Text="{Binding Body}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <Border
                                    Grid.Column="2"
                                    Margin="12,0,0,0"
                                    Padding="8,3"
                                    VerticalAlignment="Top"
                                    Background="#F1F5F9"
                                    CornerRadius="5"
                                    Visibility="{Binding Meta, Converter={StaticResource NullOrEmptyToVisibility}}">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="#64748B"
                                        Text="{Binding Meta}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <Style x:Key="HelpFaqExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel LastChildFill="True">
                            <ToggleButton
                                x:Name="HeaderSite"
                                DockPanel.Dock="Top"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Focusable="False"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter
                                                    VerticalAlignment="Center"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    RecognizesAccessKey="True" />
                                                <Path
                                                    x:Name="Arrow"
                                                    Grid.Column="1"
                                                    Width="10"
                                                    Height="6"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Data="M0,0 L5,5 L10,0"
                                                    Fill="#94A3B8"
                                                    Stretch="Uniform" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Data" Value="M0,5 L5,0 L10,5" />
                                                <Setter TargetName="Arrow" Property="Fill" Value="#64748B" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Arrow" Property="Fill" Value="#64748B" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border
                                x:Name="ContentSite"
                                Margin="0,12,0,0"
                                Padding="0,12,0,0"
                                BorderBrush="#EEF2F7"
                                BorderThickness="0,1,0,0"
                                Visibility="Collapsed">
                                <ContentPresenter />
                            </Border>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FaqTemplate" DataType="{x:Type help:HelpFaqBlock}">
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,12"
                            Padding="18,16"
                            Background="#F8FAFC"
                            BorderThickness="0"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                            <Expander
                                Style="{StaticResource HelpFaqExpanderStyle}"
                                ExpandDirection="Down"
                                IsExpanded="False"
                                Header="{Binding Question}">
                                <Expander.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="#0F172A"
                                            Text="{Binding}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </Expander.HeaderTemplate>
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="Normal"
                                    LineHeight="24"
                                    LineStackingStrategy="BlockLineHeight"
                                    Foreground="#64748B"
                                    Text="{Binding Answer}"
                                    TextWrapping="Wrap" />
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="VersionTemplate" DataType="{x:Type help:HelpVersionBlock}">
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,14"
                            Padding="16"
                            Background="#F8FAFC"
                            BorderThickness="0"
                            CornerRadius="8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border
                                        Padding="8,3"
                                        Background="#F1F5F9"
                                        CornerRadius="5">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#64748B"
                                            Text="{Binding VersionLabel}" />
                                    </Border>
                                    <TextBlock
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="#0F172A"
                                        Text="{Binding Title}" />
                                </StackPanel>
                                <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Notes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                                                <TextBlock
                                                    Margin="0,0,8,0"
                                                    FontSize="14"
                                                    Foreground="#94A3B8"
                                                    Text="•" />
                                                <TextBlock
                                                    FontSize="14"
                                                    FontWeight="Normal"
                                                    LineHeight="22"
                                                    LineStackingStrategy="BlockLineHeight"
                                                    Foreground="#64748B"
                                                    Text="{Binding}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="TipTemplate" DataType="{x:Type help:HelpTipBlock}">
            <Border
                Margin="0,0,0,14"
                Padding="14,12"
                Background="#F1F5F9"
                BorderThickness="0"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#0F172A"
                        Text="{Binding Title}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="14"
                        FontWeight="Normal"
                        LineHeight="22"
                        LineStackingStrategy="BlockLineHeight"
                        Foreground="#64748B"
                        Text="{Binding Body}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="LinkTemplate" DataType="{x:Type help:HelpLinkBlock}">
            <TextBlock
                Margin="0,4,0,8"
                HorizontalAlignment="Left"
                FontSize="14"
                FontWeight="SemiBold"
                Cursor="Hand"
                Text="{Binding Text}"
                Tag="{Binding ActionId}"
                TextWrapping="Wrap"
                MouseLeftButtonUp="HelpLink_MouseLeftButtonUp">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#475569" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#0F172A" />
                                <Setter Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <help:HelpBlockTemplateSelector
            x:Key="BlockSelector"
            DescriptionTemplate="{StaticResource DescriptionTemplate}"
            HeadingTemplate="{StaticResource HeadingTemplate}"
            StepsTemplate="{StaticResource StepsTemplate}"
            CardsTemplate="{StaticResource CardsTemplate}"
            FaqTemplate="{StaticResource FaqTemplate}"
            VersionTemplate="{StaticResource VersionTemplate}"
            TipTemplate="{StaticResource TipTemplate}"
            LinkTemplate="{StaticResource LinkTemplate}" />
    </UserControl.Resources>

    <ScrollViewer
        x:Name="RootScroll"
        Padding="28,8,8,16"
        FocusVisualStyle="{x:Null}"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock
                x:Name="TitleText"
                Margin="0,0,0,16"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="#0F172A"
                TextWrapping="Wrap" />
            <ItemsControl
                x:Name="BlocksList"
                ItemTemplateSelector="{StaticResource BlockSelector}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

