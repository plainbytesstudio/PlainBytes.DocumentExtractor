<UserControl
    x:Class="PlainBytes.DocumentExtractor.MainModule"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:PlainBytes.DocumentExtractor"
    xmlns:res="clr-namespace:PlainBytes.DocumentExtractor.Resources"
    d:DesignHeight="560"
    d:DesignWidth="1000"
    FontFamily="{DynamicResource PB.Fonts.Main}"
    Foreground="{DynamicResource PB.Brushes.TextPrimary}"
    Focusable="False"
    FocusVisualStyle="{x:Null}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="ChooseFilesPrimaryButtonStyle"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Appearance" Value="Primary" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A5AD9" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1D4ED8" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BFDBFE" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="ChooseFilesButtonStyle"
            BasedOn="{StaticResource ChooseFilesPrimaryButtonStyle}"
            TargetType="ui:Button">
            <Setter Property="Width" Value="190" />
        </Style>

        <Style
            x:Key="FilesAddButtonStyle"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="Foreground" Value="#334155" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="PreviewIconButtonStyle"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#CBD5E1" />
                    <Setter Property="Background" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FileListItemBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="64" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="FileRowRemoveButtonStyle"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FEF2F2" />
                    <Setter Property="Foreground" Value="#F67069" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelHeaderTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ExtractionSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>

        <Style
            x:Key="ExtractionRowIconButtonStyle"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="Foreground" Value="#334155" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="ExtractionDeleteButtonStyle"
            BasedOn="{StaticResource ExtractionRowIconButtonStyle}"
            TargetType="ui:Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FEF2F2" />
                    <Setter Property="Foreground" Value="#F67069" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="ExtractionSecondaryButtonStyle"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#EEF2F7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="ExtractionPrimaryButtonStyle"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Appearance" Value="Primary" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A5AD9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="FlyoutPrimaryButtonStyle"
            BasedOn="{StaticResource ExtractionPrimaryButtonStyle}"
            TargetType="ui:Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="13" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BFDBFE" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Save changes / Save as template 分割按钮组 -->
        <Style x:Key="SecondarySplitHostStyle" TargetType="Border">
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#EEF2F7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="SecondarySplitPrimaryButtonStyle"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="SecondarySplitChevronButtonStyle"
            BasedOn="{StaticResource SecondarySplitPrimaryButtonStyle}"
            TargetType="ui:Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="SecondarySplitDividerStyle" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="0,8" />
            <Setter Property="Background" Value="#EEF2F7" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="IndexBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#EEF2F7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="AnchorTableBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#EEF2F7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="FieldRulerBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#FFFBEB" />
            <Setter Property="BorderBrush" Value="#FDE68A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="TemplateComboHostStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#EEF2F7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                    <Setter Property="Background" Value="#F8FAFC" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TemplateComboItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Win11-like segmented control for anchor kind -->
        <Style x:Key="AnchorKindSegmentHostStyle" TargetType="Border">
            <Setter Property="Margin" Value="16,8,8,10" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#EEF2F7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>

        <Style x:Key="AnchorKindSegmentButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8EEF5" />
                    <Setter Property="Foreground" Value="#334155" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AnchorExpandedPanelStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="0,0,0,6" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="SelectionRailStyle" TargetType="Border">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style x:Key="AnchorRowBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsListDragging}" Value="True">
                    <Setter Property="Opacity" Value="0.4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldRowBorderStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="16,0,8,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#EEF2F7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsListDragging}" Value="True">
                    <Setter Property="Opacity" Value="0.4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ListDropLineStyle" TargetType="Border">
            <Setter Property="Height" Value="2" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="0" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,28"
            HorizontalAlignment="Stretch"
            Orientation="Horizontal">
            <Image
                Width="40"
                Height="40"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                RenderOptions.BitmapScalingMode="HighQuality"
                SnapsToDevicePixels="True"
                Source="pack://application:,,,/PlainBytes.Core;component/Assets/Images/extractor.png" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    FontSize="30"
                    FontWeight="SemiBold"
                    LineHeight="40"
                    LineStackingStrategy="BlockLineHeight"
                    Foreground="{DynamicResource PB.Brushes.TextPrimary}"
                    Text="{x:Static res:Strings.Home_Title}" />
                <TextBlock
                    Margin="0,6,0,0"
                    FontSize="15"
                    LineHeight="24"
                    LineStackingStrategy="BlockLineHeight"
                    Foreground="{DynamicResource PB.Brushes.TextSecondary}"
                    Text="{x:Static res:Strings.Home_Subtitle}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <!-- 空态拖放区 -->
        <Border
            x:Name="DropZone"
            Grid.Row="1"
            Margin="0,0,0,30"
            Padding="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AllowDrop="True"
            Background="#FAFCFF"
            BorderThickness="0"
            CornerRadius="12"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True"
            DragEnter="DropZone_DragEnter"
            DragLeave="DropZone_DragLeave"
            DragOver="DropZone_DragOver"
            Drop="DropZone_Drop">
            <Grid>
                <Rectangle
                    x:Name="DropZoneStroke"
                    RadiusX="12"
                    RadiusY="12"
                    Stroke="#60A5FA"
                    StrokeDashArray="4 3"
                    StrokeThickness="1"
                    StrokeLineJoin="Round"
                    SnapsToDevicePixels="True"
                    IsHitTestVisible="False" />

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Image
                        Width="128"
                        Height="128"
                        HorizontalAlignment="Center"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        SnapsToDevicePixels="True"
                        Source="pack://application:,,,/PlainBytes.DocumentExtractor;component/Assets/Images/pdf-files.png" />

                    <TextBlock
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="#0F172A"
                        Text="{x:Static res:Strings.Home_DropTitle}"
                        TextAlignment="Center" />

                    <TextBlock
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        FontWeight="Normal"
                        Foreground="#64748B"
                        Text="{x:Static res:Strings.Home_DropSubtitle}"
                        TextAlignment="Center" />

                    <ui:Button
                        x:Name="ChooseFilesButton"
                        Margin="0,24,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource ChooseFilesButtonStyle}"
                        Click="ChooseFilesButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon
                                Width="20"
                                Height="20"
                                Margin="0,0,10,0"
                                FontSize="20"
                                Foreground="#FFFFFF"
                                Symbol="FolderOpen24"
                                VerticalAlignment="Center" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#FFFFFF"
                                Text="{x:Static res:Strings.Home_ChooseFiles}" />
                        </StackPanel>
                    </ui:Button>

                    <TextBlock
                        Margin="0,24,0,0"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        FontWeight="Normal"
                        Foreground="#94A3B8"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Text="{x:Static res:Strings.Home_BatchHint}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 三栏工作区：Files 220 / PDF *≥420 / Extraction 350
             用背景色分区，不用 1px 分割线；描边叠在最上层保留圆角外轮廓。
             子元素需圆角 Clip（CornerRadius 本身不裁切子内容）。 -->
        <Grid
            x:Name="WorkspacePanel"
            Grid.Row="1"
            Margin="0,0,0,30"
            Visibility="Collapsed"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
            <Border Background="#F8FAFC" CornerRadius="12" />
            <Grid
                x:Name="WorkspaceColumns"
                SizeChanged="WorkspaceColumns_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" MinWidth="400" />
                    <ColumnDefinition Width="350" />
                </Grid.ColumnDefinitions>

                <!-- Files：侧栏浅底 -->
                <Border
                    x:Name="FilesColumn"
                    Grid.Column="0"
                    Background="#F8FAFC"
                    AllowDrop="True"
                    DragEnter="FilesColumn_DragEnter"
                    DragOver="FilesColumn_DragOver"
                    DragLeave="FilesColumn_DragLeave"
                    Drop="FilesColumn_Drop">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Padding="16,0"
                            Background="#F1F5F9">
                            <Grid>
                                <TextBlock
                                    x:Name="FilesHeaderText"
                                    Style="{StaticResource PanelHeaderTitleStyle}"
                                    HorizontalAlignment="Left"
                                    Text="" />
                                <ui:Button
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource FilesAddButtonStyle}"
                                    ToolTip="{x:Static res:Strings.ToolTip_AddFiles}"
                                    Click="AddFilesButton_Click">
                                    <ui:SymbolIcon FontSize="16" Symbol="Add24" />
                                </ui:Button>
                            </Grid>
                        </Border>

                        <ScrollViewer
                            x:Name="FilesListScroll"
                            Grid.Row="1"
                            FocusVisualStyle="{x:Null}"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="FileListItems" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:PdfFileItem}">
                                        <Border
                                            Style="{StaticResource FileListItemBorderStyle}"
                                            MouseLeftButtonUp="FileItem_MouseLeftButtonUp">
                                            <Grid>
                                                <Border
                                                    Margin="-16,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource SelectionRailStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Image
                                                        Grid.Column="0"
                                                        Width="32"
                                                        Height="32"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center"
                                                        RenderOptions.BitmapScalingMode="HighQuality"
                                                        SnapsToDevicePixels="True"
                                                        Source="pack://application:,,,/PlainBytes.DocumentExtractor;component/Assets/Images/pdf.png" />

                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Margin="0,0,4,0"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="14"
                                                            FontWeight="Normal"
                                                            Text="{Binding FileName}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="NoWrap"
                                                            ToolTip="{Binding FileName}"
                                                            ToolTipService.InitialShowDelay="400"
                                                            ToolTipService.BetweenShowDelay="100">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#0F172A" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock
                                                            Margin="0,2,0,0"
                                                            FontSize="12"
                                                            FontWeight="Normal"
                                                            Foreground="#94A3B8"
                                                            Text="{Binding MetaLine}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="NoWrap" />
                                                    </StackPanel>

                                                    <ui:Button
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource FileRowRemoveButtonStyle}"
                                                        ToolTip="{x:Static res:Strings.ToolTip_RemoveFile}"
                                                        Click="FileItemRemove_Click">
                                                        <ui:SymbolIcon
                                                            FontSize="14"
                                                            Symbol="Dismiss24"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                                                    </ui:Button>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Files 拖入覆盖层：仅拖入 Files 区域时显示 -->
                        <Grid
                            x:Name="FilesDropOverlay"
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Visibility="Collapsed"
                            IsHitTestVisible="False">
                            <Rectangle
                                Fill="#F5F9FF"
                                Opacity="0.92"
                                Stroke="#2563EB"
                                StrokeThickness="1"
                                StrokeDashArray="4 3"
                                SnapsToDevicePixels="True" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#2563EB"
                                TextAlignment="Center"
                                Text="{x:Static res:Strings.Home_CompactDrop}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- PDF Preview：主视觉区白底，与侧栏背景分区 -->
                <Grid Grid.Column="1" Background="#FFFFFF">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 工具栏：翻页 / 页码 / 缩放 -->
                    <Border
                        Grid.Row="0"
                        Padding="12,0"
                        Background="#F1F5F9">
                        <StackPanel
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                            <!-- 翻页 -->
                            <ui:Button
                                x:Name="PrevPageButton"
                                Style="{StaticResource PreviewIconButtonStyle}"
                                ToolTip="{x:Static res:Strings.ToolTip_PreviousPage}"
                                Click="PrevPageButton_Click">
                                <ui:SymbolIcon
                                    FontSize="16"
                                    Symbol="ChevronUp24"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                            </ui:Button>
                            <ui:Button
                                x:Name="NextPageButton"
                                Margin="2,0,0,0"
                                Style="{StaticResource PreviewIconButtonStyle}"
                                ToolTip="{x:Static res:Strings.ToolTip_NextPage}"
                                Click="NextPageButton_Click">
                                <ui:SymbolIcon
                                    FontSize="16"
                                    Symbol="ChevronDown24"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                            </ui:Button>

                            <!-- 页码：当前页 / 总页数 -->
                            <StackPanel
                                Margin="12,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                                <Border
                                    Width="38"
                                    Height="30"
                                    Background="#FFFFFF"
                                    BorderBrush="#EEF2F7"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                    <TextBox
                                        x:Name="PageNumberBox"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CaretBrush="#64748B"
                                        FontSize="12"
                                        Foreground="#0F172A"
                                        Text="1"
                                        TextAlignment="Center"
                                        MaxLength="5"
                                        PreviewKeyDown="PageNumberBox_PreviewKeyDown"
                                        LostFocus="PageNumberBox_LostFocus" />
                                </Border>
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#94A3B8"
                                    Text="/" />
                                <TextBlock
                                    x:Name="PageCountText"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#64748B"
                                    Text="1" />
                            </StackPanel>

                            <!-- 缩放：- 100% + -->
                            <Border
                                Margin="12,0,0,0"
                                Height="32"
                                MinWidth="106"
                                VerticalAlignment="Center"
                                Background="#FFFFFF"
                                BorderBrush="#EEF2F7"
                                BorderThickness="1"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                                <StackPanel
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                    <ui:Button
                                        x:Name="ZoomOutButton"
                                        Style="{StaticResource PreviewIconButtonStyle}"
                                        ToolTip="{x:Static res:Strings.ToolTip_ZoomOut}"
                                        Click="ZoomOutButton_Click">
                                        <ui:SymbolIcon
                                            FontSize="16"
                                            Symbol="Subtract24"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                                    </ui:Button>
                                    <TextBlock
                                        x:Name="ZoomPercentText"
                                        MinWidth="42"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="Normal"
                                        Foreground="#0F172A"
                                        Text="100%"
                                        TextAlignment="Center" />
                                    <ui:Button
                                        x:Name="ZoomInButton"
                                        Style="{StaticResource PreviewIconButtonStyle}"
                                        ToolTip="{x:Static res:Strings.ToolTip_ZoomIn}"
                                        Click="ZoomInButton_Click">
                                        <ui:SymbolIcon
                                            FontSize="16"
                                            Symbol="Add24"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                                    </ui:Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- PDF 页面区域：深色铺在外层 Border，避免主题覆盖 ScrollViewer.Background -->
                    <Border
                        Grid.Row="1"
                        Background="#2B2D31"
                        ClipToBounds="True">
                        <Grid>
                            <ScrollViewer
                                x:Name="PdfViewer"
                                Padding="20"
                                Background="Transparent"
                                Focusable="True"
                                FocusVisualStyle="{x:Null}"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto"
                                PreviewMouseWheel="PdfViewer_PreviewMouseWheel">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border
                                        x:Name="PdfPageSurface"
                                        Width="595"
                                        Height="842"
                                        Background="#FFFFFF"
                                        Cursor="Cross"
                                        FlowDirection="LeftToRight"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True">
                                        <Grid>
                                            <Border Background="#FFFFFF">
                                                <Border.Effect>
                                                    <DropShadowEffect
                                                        BlurRadius="16"
                                                        Direction="270"
                                                        Opacity="0.28"
                                                        ShadowDepth="4"
                                                        Color="#000000" />
                                                </Border.Effect>
                                                <Image
                                                    x:Name="PdfPageImage"
                                                    Stretch="Fill"
                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                    SnapsToDevicePixels="True" />
                                            </Border>
                                            <Canvas
                                                x:Name="FieldOverlayCanvas"
                                                IsHitTestVisible="False" />
                                            <Canvas
                                                x:Name="SelectionLayer"
                                                Background="Transparent"
                                                MouseLeftButtonDown="SelectionLayer_MouseLeftButtonDown"
                                                MouseMove="SelectionLayer_MouseMove"
                                                MouseLeftButtonUp="SelectionLayer_MouseLeftButtonUp"
                                                LostMouseCapture="SelectionLayer_LostMouseCapture">
                                                <Rectangle
                                                    x:Name="SelectionRubberBand"
                                                    Stroke="#E5484D"
                                                    StrokeThickness="1"
                                                    Fill="#28E5484D"
                                                    Visibility="Collapsed"
                                                    IsHitTestVisible="False" />
                                            </Canvas>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                            <!-- 覆盖整个预览区（含深灰留白），切换/渲染 PDF 时显示 -->
                            <Border
                                x:Name="PdfViewerLoadingHost"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="#590F172A"
                                Opacity="0"
                                IsHitTestVisible="False">
                                <Border
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MinWidth="160"
                                    Padding="28,24"
                                    Background="#FFFFFF"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="16"
                                            Direction="270"
                                            Opacity="0.12"
                                            ShadowDepth="4"
                                            Color="#000000" />
                                    </Border.Effect>
                                    <StackPanel HorizontalAlignment="Center">
                                        <Grid
                                            Width="32"
                                            Height="32"
                                            RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <RotateTransform />
                                            </Grid.RenderTransform>
                                            <Grid.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                From="0"
                                                                To="360"
                                                                Duration="0:0:0.9" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Grid.Triggers>
                                            <Ellipse
                                                Width="32"
                                                Height="32"
                                                Fill="Transparent"
                                                Stroke="#E8F1FF"
                                                StrokeThickness="3" />
                                            <Ellipse
                                                Width="32"
                                                Height="32"
                                                Fill="Transparent"
                                                Stroke="#1677FF"
                                                StrokeDashArray="2.4 7.6"
                                                StrokeThickness="3" />
                                        </Grid>
                                        <TextBlock
                                            Margin="0,12,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="13"
                                            Foreground="#344054"
                                            Text="{x:Static res:Strings.Loading_GeneratingPreview}" />
                                    </StackPanel>
                                </Border>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 操作反馈：预览区顶部信息卡（对齐底部 FooterTip / 选中态） -->
                    <Border
                        x:Name="PageAnchorToast"
                        Grid.Row="1"
                        Margin="12,10,12,0"
                        Padding="12,10"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Panel.ZIndex="220"
                        Background="#F8FAFC"
                        BorderBrush="#EEF2F7"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed"
                        SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="12"
                                Direction="270"
                                Opacity="0.10"
                                ShadowDepth="2"
                                Color="#000000" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="#64748B"
                                Symbol="Info24" />
                            <TextBlock
                                x:Name="PageAnchorToastText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Normal"
                                LineHeight="20"
                                Foreground="#334155"
                                TextWrapping="Wrap" />
                            <ui:Button
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource ExtractionRowIconButtonStyle}"
                                ToolTip="{x:Static res:Strings.ToolTip_Dismiss}"
                                Click="PageAnchorToastClose_Click">
                                <ui:SymbolIcon
                                    FontSize="14"
                                    Symbol="Dismiss24"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                            </ui:Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Extraction：侧栏浅底；区内用色块分区，不用横线 -->
                <Grid Grid.Column="2" Background="#F8FAFC">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="0" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Template -->
                    <Border
                        Grid.Row="0"
                        Padding="16"
                        Background="#F1F5F9">
                    <StackPanel>
                        <TextBlock
                            Style="{StaticResource ExtractionSectionTitleStyle}"
                            Text="{x:Static res:Strings.Panel_Template}" />
                        <Grid Margin="0,8,0,0" Panel.ZIndex="40">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="TemplateComboHost"
                                Grid.Row="0"
                                Style="{StaticResource TemplateComboHostStyle}"
                                Margin="0"
                                MouseLeftButtonUp="TemplateComboHost_MouseLeftButtonUp">
                                <Grid Margin="10,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="TemplateComboText"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="Normal"
                                        Foreground="#0F172A"
                                        TextTrimming="CharacterEllipsis" />
                                    <ui:SymbolIcon
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="#64748B"
                                        Symbol="ChevronDown24" />
                                </Grid>
                            </Border>
                            <!-- 页内展开：避免 Popup 首次挂树触发 SelectionChanged→重载模板导致空白卡顿 -->
                            <Border
                                x:Name="TemplateComboDrop"
                                Grid.Row="1"
                                Margin="0,4,0,0"
                                MaxHeight="280"
                                Background="#FFFFFF"
                                BorderBrush="#EEF2F7"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="Collapsed"
                                SnapsToDevicePixels="True">
                                <ListBox
                                    x:Name="TemplateCombo"
                                    Style="{x:Null}"
                                    Padding="4"
                                    Background="#FFFFFF"
                                    BorderThickness="0"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ItemContainerStyle="{StaticResource TemplateComboItemStyle}"
                                    DisplayMemberPath="DisplayName"
                                    SelectionChanged="TemplateCombo_SelectionChanged" />
                            </Border>
                        </Grid>
                        <StackPanel
                            x:Name="TemplateModifiedPanel"
                            Margin="0,8,0,0"
                            Orientation="Horizontal"
                            Visibility="Hidden">
                            <Ellipse
                                Width="6"
                                Height="6"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Fill="#D97706" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="Normal"
                                Foreground="#94A3B8"
                                Text="{x:Static res:Strings.Extraction_TemplateModified}" />
                        </StackPanel>
                    </StackPanel>
                    </Border>

                    <!-- Anchors with nested fields -->
                    <Grid Grid.Row="1" MinHeight="0" Background="#F8FAFC">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="16,12,8,12">
                            <TextBlock
                                x:Name="AnchorsHeaderText"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource ExtractionSectionTitleStyle}"
                                Text="" />
                            <ui:Button
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource ExtractionRowIconButtonStyle}"
                                Focusable="False">
                                <ui:Button.ToolTip>
                                    <ToolTip MaxWidth="280">
                                        <StackPanel>
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="#0F172A"
                                                Text="{x:Static res:Strings.Extraction_AddingAnchors}" />
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                FontSize="12"
                                                Foreground="#64748B"
                                                TextWrapping="Wrap"
                                                Text="{x:Static res:Strings.Extraction_AnchorsHint}" />
                                        </StackPanel>
                                    </ToolTip>
                                </ui:Button.ToolTip>
                                <ui:SymbolIcon
                                    FontSize="14"
                                    Symbol="Info24"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                            </ui:Button>
                        </Grid>
                        <Grid Grid.Row="1">
                            <ScrollViewer
                                FocusVisualStyle="{x:Null}"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="AnchorListItems" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:AnchorItem}">
                                            <StackPanel>
                                                <Border
                                                    Style="{StaticResource AnchorRowBorderStyle}"
                                                    AllowDrop="True"
                                                    PreviewMouseLeftButtonDown="AnchorRow_PreviewMouseLeftButtonDown"
                                                    MouseMove="AnchorRow_MouseMove"
                                                    DragOver="AnchorRow_DragOver"
                                                    DragLeave="ListRow_DragLeave"
                                                    Drop="AnchorRow_Drop"
                                                    MouseLeftButtonUp="AnchorItem_MouseLeftButtonUp">
                                                    <Grid>
                                                        <Border Margin="-16,0,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource SelectionRailStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <ui:Button
                                                                Grid.Column="0"
                                                                Margin="0,0,2,0"
                                                                VerticalAlignment="Center"
                                                                Style="{StaticResource ExtractionRowIconButtonStyle}"
                                                                ToolTip="{x:Static res:Strings.ToolTip_ExpandAnchor}"
                                                                Click="AnchorExpand_Click">
                                                                <ui:SymbolIcon
                                                                    FontSize="14"
                                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}">
                                                                    <ui:SymbolIcon.Style>
                                                                        <Style TargetType="ui:SymbolIcon">
                                                                            <Setter Property="Symbol" Value="ChevronRight24" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                    <Setter Property="Symbol" Value="ChevronDown24" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ui:SymbolIcon.Style>
                                                                </ui:SymbolIcon>
                                                            </ui:Button>
                                                            <Border Grid.Column="1" Style="{StaticResource IndexBadgeStyle}">
                                                                <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="11"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="#64748B"
                                                                    Text="{Binding Index}" />
                                                            </Border>
                                                            <Grid
                                                                Grid.Column="2"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,4,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    Grid.Column="0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="14"
                                                                    FontWeight="Normal"
                                                                    Foreground="#0F172A"
                                                                    Text="{Binding Name}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <Border
                                                                    Grid.Column="1"
                                                                    Style="{StaticResource AnchorTableBadgeStyle}"
                                                                    Visibility="{Binding TableBadgeVisibility}">
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="#475569"
                                                                        Text="{x:Static res:Strings.AnchorKind_TableBadge}" />
                                                                </Border>
                                                            </Grid>
                                                            <ui:Button
                                                                Grid.Column="3"
                                                                Margin="2,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Style="{StaticResource ExtractionDeleteButtonStyle}"
                                                                ToolTip="{x:Static res:Strings.ToolTip_Delete}"
                                                                Click="AnchorDelete_Click">
                                                                <ui:SymbolIcon
                                                                    FontSize="14"
                                                                    Symbol="Dismiss24"
                                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                                                            </ui:Button>
                                                        </Grid>
                                                        <Border
                                                            Style="{StaticResource ListDropLineStyle}"
                                                            VerticalAlignment="Top"
                                                            Margin="0,-1,0,0"
                                                            Visibility="{Binding ShowDropLineBefore, Converter={StaticResource BoolToVis}}" />
                                                        <Border
                                                            Style="{StaticResource ListDropLineStyle}"
                                                            VerticalAlignment="Bottom"
                                                            Margin="0,0,0,-1"
                                                            Visibility="{Binding ShowDropLineAfter, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </Border>

                                                <Border
                                                    Style="{StaticResource AnchorExpandedPanelStyle}"
                                                    Visibility="{Binding FieldsPanelVisibility}">
                                                    <StackPanel>
                                                    <Border Style="{StaticResource AnchorKindSegmentHostStyle}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <ui:Button
                                                                Grid.Column="0"
                                                                Margin="0,0,2,0"
                                                                HorizontalAlignment="Stretch"
                                                                Click="AnchorKindValue_Click">
                                                                <ui:Button.Style>
                                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource AnchorKindSegmentButtonStyle}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsValueKind}" Value="True">
                                                                                <Setter Property="Background" Value="#FFFFFF" />
                                                                                <Setter Property="BorderBrush" Value="#EEF2F7" />
                                                                                <Setter Property="Foreground" Value="#0F172A" />
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </DataTrigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsValueKind}" Value="True" />
                                                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Background" Value="#FFFFFF" />
                                                                                <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                                                <Setter Property="Foreground" Value="#0F172A" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ui:Button.Style>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                    <ui:SymbolIcon
                                                                        Margin="0,0,6,0"
                                                                        FontSize="14"
                                                                        Symbol="TextBulletListLtr24"
                                                                        VerticalAlignment="Center"
                                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        Text="{x:Static res:Strings.AnchorKind_Value}"
                                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                                                                </StackPanel>
                                                            </ui:Button>
                                                            <ui:Button
                                                                Grid.Column="1"
                                                                Margin="2,0,0,0"
                                                                HorizontalAlignment="Stretch"
                                                                Click="AnchorKindTable_Click">
                                                                <ui:Button.Style>
                                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource AnchorKindSegmentButtonStyle}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsTableKind}" Value="True">
                                                                                <Setter Property="Background" Value="#FFFFFF" />
                                                                                <Setter Property="BorderBrush" Value="#EEF2F7" />
                                                                                <Setter Property="Foreground" Value="#0F172A" />
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </DataTrigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsTableKind}" Value="True" />
                                                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Background" Value="#FFFFFF" />
                                                                                <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                                                <Setter Property="Foreground" Value="#0F172A" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ui:Button.Style>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                    <ui:SymbolIcon
                                                                        Margin="0,0,6,0"
                                                                        FontSize="14"
                                                                        Symbol="Table24"
                                                                        VerticalAlignment="Center"
                                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        Text="{x:Static res:Strings.AnchorKind_Table}"
                                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                                                                </StackPanel>
                                                            </ui:Button>
                                                        </Grid>
                                                    </Border>

                                                    <ItemsControl
                                                        ItemsSource="{Binding Fields}"
                                                        Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type local:FieldItem}">
                                                            <!-- 外层含行间距，插入线落在间距正中（与锚点行间指示一致） -->
                                                            <Grid Margin="16,0,8,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="6" />
                                                                </Grid.RowDefinitions>
                                                                <Border
                                                                    Grid.Row="0"
                                                                    Style="{StaticResource FieldRowBorderStyle}"
                                                                    Margin="0"
                                                                    AllowDrop="True"
                                                                    PreviewMouseLeftButtonDown="FieldRow_PreviewMouseLeftButtonDown"
                                                                    MouseMove="FieldRow_MouseMove"
                                                                    DragOver="FieldRow_DragOver"
                                                                    DragLeave="ListRow_DragLeave"
                                                                    Drop="FieldRow_Drop"
                                                                    MouseLeftButtonUp="FieldItem_MouseLeftButtonUp">
                                                                <Grid>
                                                                    <Border Margin="-12,0,0,0">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border" BasedOn="{StaticResource SelectionRailStyle}">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                    </Border>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Grid.Column="0" Style="{StaticResource IndexBadgeStyle}">
                                                                            <TextBlock
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"
                                                                                FontSize="11"
                                                                                FontWeight="SemiBold"
                                                                                Foreground="#64748B"
                                                                                Text="{Binding Index}" />
                                                                        </Border>
                                                                        <Grid
                                                                            Grid.Column="1"
                                                                            VerticalAlignment="Center"
                                                                            Margin="0,0,4,0">
                                                                            <StackPanel>
                                                                                <StackPanel.Style>
                                                                                    <Style TargetType="StackPanel">
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </StackPanel.Style>
                                                                                <DockPanel LastChildFill="True">
                                                                                    <Border
                                                                                        DockPanel.Dock="Right"
                                                                                        Style="{StaticResource FieldRulerBadgeStyle}"
                                                                                        Visibility="{Binding RulerBadgeVisibility}">
                                                                                        <TextBlock
                                                                                            FontSize="11"
                                                                                            FontWeight="SemiBold"
                                                                                            Foreground="#B45309"
                                                                                            Text="{x:Static res:Strings.Field_RulerBadge}" />
                                                                                    </Border>
                                                                                    <TextBlock
                                                                                        VerticalAlignment="Center"
                                                                                        FontSize="14"
                                                                                        FontWeight="Normal"
                                                                                        Foreground="#0F172A"
                                                                                        Text="{Binding Name}"
                                                                                        TextTrimming="CharacterEllipsis" />
                                                                                </DockPanel>
                                                                                <TextBlock
                                                                                    Margin="0,3,0,0"
                                                                                    FontSize="12"
                                                                                    FontWeight="Normal"
                                                                                    Foreground="#94A3B8"
                                                                                    Text="{Binding Value}"
                                                                                    TextTrimming="CharacterEllipsis"
                                                                                    Visibility="{Binding DataContext.IsValueKind, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}" />
                                                                            </StackPanel>
                                                                            <Border
                                                                                Height="30"
                                                                                Padding="8,0"
                                                                                VerticalAlignment="Center"
                                                                                Background="#FFFFFF"
                                                                                BorderBrush="#EEF2F7"
                                                                                BorderThickness="1"
                                                                                CornerRadius="6"
                                                                                ClipToBounds="True"
                                                                                SnapsToDevicePixels="True">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <TextBox
                                                                                    x:Name="FieldNameEditBox"
                                                                                    Height="28"
                                                                                    Margin="0"
                                                                                    Padding="0"
                                                                                    VerticalAlignment="Center"
                                                                                    VerticalContentAlignment="Center"
                                                                                    Background="Transparent"
                                                                                    BorderThickness="0"
                                                                                    CaretBrush="#64748B"
                                                                                    FontSize="14"
                                                                                    Foreground="#0F172A"
                                                                                    Text="{Binding Name, Mode=OneWay}"
                                                                                    PreviewKeyDown="FieldNameEditBox_PreviewKeyDown"
                                                                                    LostFocus="FieldNameEditBox_LostFocus"
                                                                                    Loaded="FieldNameEditBox_Loaded"
                                                                                    IsVisibleChanged="FieldNameEditBox_IsVisibleChanged">
                                                                                    <TextBox.Style>
                                                                                        <Style TargetType="TextBox">
                                                                                            <Setter Property="Padding" Value="0" />
                                                                                            <Setter Property="BorderThickness" Value="0" />
                                                                                            <Setter Property="Background" Value="Transparent" />
                                                                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                                                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                                                        </Style>
                                                                                    </TextBox.Style>
                                                                                </TextBox>
                                                                            </Border>
                                                                        </Grid>
                                                                        <ui:Button
                                                                            Grid.Column="2"
                                                                            Margin="4,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            Style="{StaticResource ExtractionRowIconButtonStyle}"
                                                                            ToolTip="{x:Static res:Strings.ToolTip_SetRulerColumn}"
                                                                            Click="FieldRulerColumn_Click"
                                                                            Visibility="{Binding DataContext.IsTableKind, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}">
                                                                            <ui:SymbolIcon FontSize="14">
                                                                                <ui:SymbolIcon.Style>
                                                                                    <Style TargetType="ui:SymbolIcon">
                                                                                        <Setter Property="Symbol" Value="Star24" />
                                                                                        <Setter Property="Filled" Value="False" />
                                                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsRulerColumn}" Value="True">
                                                                                                <Setter Property="Filled" Value="True" />
                                                                                                <Setter Property="Foreground" Value="#EAB308" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </ui:SymbolIcon.Style>
                                                                            </ui:SymbolIcon>
                                                                        </ui:Button>
                                                                        <ui:Button
                                                                            Grid.Column="3"
                                                                            Margin="4,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            Style="{StaticResource ExtractionRowIconButtonStyle}"
                                                                            ToolTip="{x:Static res:Strings.ToolTip_RenameField}"
                                                                            Click="FieldEditName_Click"
                                                                            Visibility="{Binding DataContext.IsValueKind, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}">
                                                                            <ui:SymbolIcon
                                                                                FontSize="14"
                                                                                Symbol="Edit24"
                                                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                                                                        </ui:Button>
                                                                        <ui:Button
                                                                            Grid.Column="4"
                                                                            Margin="2,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            Style="{StaticResource ExtractionDeleteButtonStyle}"
                                                                            ToolTip="{x:Static res:Strings.ToolTip_Delete}"
                                                                            Click="FieldDelete_Click"
                                                                            Visibility="{Binding DataContext.IsValueKind, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}">
                                                                            <ui:SymbolIcon
                                                                                FontSize="14"
                                                                                Symbol="Dismiss24"
                                                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                                                                        </ui:Button>
                                                                    </Grid>
                                                                </Grid>
                                                                </Border>
                                                                <Border
                                                                    Grid.Row="0"
                                                                    Style="{StaticResource ListDropLineStyle}"
                                                                    VerticalAlignment="Top"
                                                                    Margin="0,-3,0,0"
                                                                    Visibility="{Binding ShowDropLineBefore, Converter={StaticResource BoolToVis}}" />
                                                                <Border
                                                                    Grid.Row="1"
                                                                    Style="{StaticResource ListDropLineStyle}"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding ShowDropLineAfter, Converter={StaticResource BoolToVis}}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock
                                x:Name="AnchorsEmptyHint"
                                Margin="16,4,16,16"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                FontSize="12"
                                LineHeight="18"
                                FontWeight="Normal"
                                Foreground="#94A3B8"
                                TextWrapping="Wrap"
                                IsHitTestVisible="False"
                                Text="{x:Static res:Strings.Extraction_AnchorsEmpty}" />
                        </Grid>
                    </Grid>

                    <!-- 底部操作区：色块分区，无顶部分割线 -->
                    <Border
                        Grid.Row="2"
                        Height="68"
                        Padding="16,12"
                        Background="#F1F5F9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid x:Name="SecondaryActionHost" Grid.Column="0">
                                <Border Style="{StaticResource SecondarySplitHostStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ui:Button
                                            x:Name="SecondaryActionButton"
                                            Grid.Column="0"
                                            HorizontalAlignment="Stretch"
                                            Style="{StaticResource SecondarySplitPrimaryButtonStyle}"
                                            Click="SecondaryActionButton_Click">
                                            <TextBlock
                                                x:Name="SecondaryActionText"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                FontWeight="Medium"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}"
                                                Text="{x:Static res:Strings.Extraction_SaveAsTemplate}" />
                                        </ui:Button>

                                        <Border
                                            x:Name="SecondaryActionDivider"
                                            Grid.Column="1"
                                            Style="{StaticResource SecondarySplitDividerStyle}"
                                            Visibility="Collapsed" />

                                        <ui:Button
                                            x:Name="SecondaryActionMenuButton"
                                            Grid.Column="2"
                                            Style="{StaticResource SecondarySplitChevronButtonStyle}"
                                            ToolTip="{x:Static res:Strings.ToolTip_MoreSaveOptions}"
                                            Visibility="Collapsed"
                                            Click="SecondaryActionMenuButton_Click">
                                            <ui:SymbolIcon
                                                FontSize="12"
                                                Symbol="ChevronDown24"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                                        </ui:Button>
                                    </Grid>
                                </Border>

                            </Grid>

                            <ui:Button
                                x:Name="ExtractButton"
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource ExtractionPrimaryButtonStyle}"
                                Content="{x:Static res:Strings.Extraction_Extract}"
                                Click="ExtractButton_Click" />
                        </Grid>
                    </Border>

                </Grid>

            </Grid>
            <Border
                Background="Transparent"
                BorderBrush="#EEF2F7"
                BorderThickness="1"
                CornerRadius="12"
                IsHitTestVisible="False"
                SnapsToDevicePixels="True" />
        </Grid>

        <!-- 另存模板：页内浮层（不用 Popup），保证韩语等 IME 与字段名输入框同一 HWND / 字体继承 -->
        <Grid
            x:Name="SaveTemplateFlyout"
            Grid.RowSpan="3"
            Panel.ZIndex="40"
            Visibility="Collapsed">
            <Border
                Background="#660F172A"
                MouseLeftButtonDown="SaveTemplateFlyoutBackdrop_MouseLeftButtonDown" />
            <Border
                Width="320"
                Padding="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FFFFFF"
                BorderBrush="#EEF2F7"
                BorderThickness="1"
                CornerRadius="8"
                SnapsToDevicePixels="True"
                PreviewKeyDown="SaveTemplateFlyoutRoot_PreviewKeyDown">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="16"
                        Direction="270"
                        Opacity="0.12"
                        ShadowDepth="4"
                        Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#0F172A"
                        Text="{x:Static res:Strings.Extraction_SaveAsTemplate}" />

                    <TextBlock
                        Margin="0,14,0,0"
                        FontSize="12"
                        Foreground="#64748B"
                        Text="{x:Static res:Strings.Extraction_TemplateName}" />

                    <Border
                        Margin="0,6,0,0"
                        Height="36"
                        Background="#FFFFFF"
                        BorderBrush="#EEF2F7"
                        BorderThickness="1"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                        <TextBox
                            x:Name="SaveTemplateNameBox"
                            Height="34"
                            Margin="10,0"
                            Padding="0"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            CaretBrush="#64748B"
                            FontSize="13"
                            Foreground="#0F172A"
                            TextChanged="SaveTemplateNameBox_TextChanged"
                            PreviewKeyDown="SaveTemplateNameBox_PreviewKeyDown" />
                    </Border>

                    <TextBlock
                        x:Name="SaveTemplateNameError"
                        Margin="0,6,0,0"
                        FontSize="12"
                        Foreground="#DC2626"
                        Text="{x:Static res:Strings.Extraction_NameConflict}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <ui:Button
                        x:Name="SaveTemplateConfirmButton"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Right"
                        Style="{StaticResource FlyoutPrimaryButtonStyle}"
                        Content="{x:Static res:Strings.Extraction_Save}"
                        Click="SaveTemplateConfirmButton_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 操作反馈气泡：锚定按钮上方或框选区域上方 -->
        <Popup
            x:Name="ActionToastPopup"
            AllowsTransparency="True"
            Placement="Top"
            StaysOpen="True"
            PopupAnimation="Fade">
            <Grid
                x:Name="ActionToastBubble"
                MaxWidth="320"
                IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    x:Name="ActionToast"
                    Grid.Row="0"
                    Padding="12,10"
                    Background="#FEF3C7"
                    BorderBrush="#FCD34D"
                    BorderThickness="1"
                    CornerRadius="8"
                    SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="12"
                            Direction="270"
                            Opacity="0.16"
                            ShadowDepth="2"
                            Color="#000000" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            x:Name="ActionToastIcon"
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            VerticalAlignment="Top"
                            FontSize="14"
                            Foreground="#64748B"
                            Symbol="Info24" />
                        <TextBlock
                            x:Name="ActionToastText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Normal"
                            Foreground="#334155"
                            LineHeight="20"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>
                <Path
                    x:Name="ActionToastCaret"
                    Grid.Row="1"
                    Width="14"
                    Height="7"
                    Margin="0,-1,0,0"
                    HorizontalAlignment="Center"
                    Data="M0,0 L7,7 L14,0 Z"
                    Fill="#FEF3C7"
                    Stroke="#FCD34D"
                    StrokeThickness="1"
                    SnapsToDevicePixels="True" />
            </Grid>
        </Popup>

        <!-- 底部提示条：适用说明 + 模板配置帮助入口 -->
        <Border
            Grid.Row="2"
            Margin="0,0,0,10"
            Padding="12,10"
            Background="#F8FAFC"
            BorderBrush="#EEF2F7"
            BorderThickness="1"
            CornerRadius="8"
            HorizontalAlignment="Stretch">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <ui:SymbolIcon
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#64748B"
                        Symbol="Info24" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="#64748B"
                        TextWrapping="Wrap"
                        Text="{x:Static res:Strings.Home_FooterTip}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Margin="20,0,0,0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="#475569"
                        Text="{x:Static res:Strings.Templates_HelpPrompt}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#2563EB"
                        Cursor="Hand"
                        Text="{x:Static res:Strings.Templates_GetSetupHelp}"
                        MouseLeftButtonUp="GetSetupHelp_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
