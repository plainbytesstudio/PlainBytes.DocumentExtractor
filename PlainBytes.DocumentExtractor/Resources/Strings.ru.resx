  <data name="About_Title" xml:space="preserve">
    <value>О программе PlainBytes DocumentExtractor</value>
  </data>
  <data name="About_Subtitle" xml:space="preserve">
    <value>Извлекайте структурированные данные из PDF-документов с фиксированной компоновкой.</value>
  </data>
  <data name="About_ProductName" xml:space="preserve">
    <value>PlainBytes DocumentExtractor</value>
  </data>
  <data name="About_ProductTagline" xml:space="preserve">
    <value>Инструмент для извлечения полей из PDF</value>
  </data>
  <data name="About_VersionFormat" xml:space="preserve">
