<UserControl
    x:Class="PlainBytes.DocumentExtractor.TemplatesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:PlainBytes.DocumentExtractor"
    xmlns:res="clr-namespace:PlainBytes.DocumentExtractor.Resources"
    d:DesignHeight="560"
    d:DesignWidth="1000"
    FontFamily="{DynamicResource PB.Fonts.Main}"
    Foreground="{DynamicResource PB.Brushes.TextPrimary}"
    Focusable="False"
    FocusVisualStyle="{x:Null}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="TemplatesToolButtonStyle"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#EEF2F7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Background" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="TemplatesToolDangerButtonStyle"
            BasedOn="{StaticResource TemplatesToolButtonStyle}"
            TargetType="ui:Button">
            <Setter Property="BorderBrush" Value="#FED4D5" />
            <Setter Property="Foreground" Value="#F67069" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FEF2F2" />
                    <Setter Property="BorderBrush" Value="#F67069" />
                    <Setter Property="Foreground" Value="#F67069" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FEE2E2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Background" Value="#FFFFFF" />
                    <Setter Property="BorderBrush" Value="#FED4D5" />
                    <Setter Property="Foreground" Value="#F67069" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="TemplatesRowMoreButtonStyle"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Foreground" Value="#5F6873" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="Foreground" Value="#334155" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TemplatesHeaderCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TemplatesRowBorderStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="62" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#EEF2F7" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2F7" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Padding" Value="0,10" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TemplatesCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border
                            x:Name="Box"
                            Width="18"
                            Height="18"
                            Background="#FFFFFF"
                            BorderBrush="#AEB6C1"
                            BorderThickness="1.5"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                            <Grid>
                                <ui:SymbolIcon
                                    x:Name="Check"
                                    FontSize="12"
                                    Foreground="#FFFFFF"
                                    Symbol="Checkmark24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed" />
                                <Border
                                    x:Name="IndeterminateMark"
                                    Width="8"
                                    Height="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#FFFFFF"
                                    CornerRadius="1"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#2563EB" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Box" Property="Background" Value="#2563EB" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="IndeterminateMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="0" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,28"
            Orientation="Horizontal">
            <Image
                Width="40"
                Height="40"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                RenderOptions.BitmapScalingMode="HighQuality"
                SnapsToDevicePixels="True"
                Source="pack://application:,,,/PlainBytes.Core;component/Assets/Images/extractor-template.png" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    FontSize="30"
                    FontWeight="SemiBold"
                    LineHeight="40"
                    LineStackingStrategy="BlockLineHeight"
                    Foreground="{DynamicResource PB.Brushes.TextPrimary}"
                    Text="{x:Static res:Strings.Templates_Title}" />
                <TextBlock
                    Margin="0,6,0,0"
                    FontSize="15"
                    LineHeight="24"
                    LineStackingStrategy="BlockLineHeight"
                    Foreground="{DynamicResource PB.Brushes.TextSecondary}"
                    Text="{x:Static res:Strings.Templates_Subtitle}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <!-- 顶部工具区 -->
        <Grid Grid.Row="1" Height="40">
            <StackPanel
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <ui:Button
                    Style="{StaticResource TemplatesToolButtonStyle}"
                    Click="ImportButton_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            FontSize="16"
                            Symbol="ArrowImport24"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="{x:Static res:Strings.Templates_Import}" />
                    </StackPanel>
                </ui:Button>
                <ui:Button
                    x:Name="ExportButton"
                    Margin="8,0,0,0"
                    Style="{StaticResource TemplatesToolButtonStyle}"
                    IsEnabled="False"
                    Click="ExportButton_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            FontSize="16"
                            Symbol="ArrowExport24"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="{x:Static res:Strings.Templates_Export}" />
                    </StackPanel>
                </ui:Button>
                <ui:Button
                    x:Name="DeleteSelectedButton"
                    Margin="8,0,0,0"
                    Style="{StaticResource TemplatesToolDangerButtonStyle}"
                    IsEnabled="False"
                    Click="DeleteSelectedButton_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            FontSize="16"
                            Symbol="Delete24"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="{x:Static res:Strings.Templates_Delete}" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>

            <Border
                Width="280"
                Height="36"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="#FFFFFF"
                BorderBrush="#EEF2F7"
                BorderThickness="1"
                CornerRadius="6"
                SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#EEF2F7" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="True">
                                <Setter Property="BorderBrush" Value="#E2E8F0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="#94A3B8"
                        Symbol="Search24" />
                    <Grid Grid.Column="1">
                        <TextBlock
                            x:Name="SearchPlaceholder"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="Normal"
                            Foreground="#94A3B8"
                            IsHitTestVisible="False"
                            Text="{x:Static res:Strings.Templates_Search}" />
                        <TextBox
                            x:Name="SearchBox"
                            Height="34"
                            Padding="0"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            CaretBrush="#64748B"
                            FontSize="14"
                            Foreground="#172033"
                            TextChanged="SearchBox_TextChanged" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 模板列表：浅底分区，表头色块区分，行间弱分隔 -->
        <Border
            Grid.Row="2"
            Margin="0,20,0,0"
            Background="#F8FAFC"
            BorderBrush="#EEF2F7"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 表头：色块分区 -->
                <Border
                    Grid.Row="0"
                    Background="#F1F5F9"
                    CornerRadius="8,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>

                        <CheckBox
                            x:Name="HeaderCheckBox"
                            Grid.Column="0"
                            Style="{StaticResource TemplatesCheckBoxStyle}"
                            IsThreeState="True"
                            Click="HeaderCheckBox_Click" />

                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource TemplatesHeaderCellStyle}"
                            Text="{x:Static res:Strings.Templates_ColName}" />
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource TemplatesHeaderCellStyle}"
                            Text="{x:Static res:Strings.Templates_ColFields}" />
                        <TextBlock
                            Grid.Column="3"
                            Style="{StaticResource TemplatesHeaderCellStyle}"
                            Text="{x:Static res:Strings.Templates_ColAnchors}" />
                        <TextBlock
                            Grid.Column="4"
                            Style="{StaticResource TemplatesHeaderCellStyle}"
                            Text="{x:Static res:Strings.Templates_ColModified}" />
                        <TextBlock
                            Grid.Column="5"
                            Style="{StaticResource TemplatesHeaderCellStyle}"
                            HorizontalAlignment="Center"
                            Text="{x:Static res:Strings.Templates_ColActions}" />
                    </Grid>
                </Border>

                <ScrollViewer
                    Grid.Row="1"
                    FocusVisualStyle="{x:Null}"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TemplateListItems" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:TemplateListItem}">
                                <Border Style="{StaticResource TemplatesRowBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox
                                            Grid.Column="0"
                                            Style="{StaticResource TemplatesCheckBoxStyle}"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                            Click="RowCheckBox_Click" />

                                        <Grid
                                            Grid.Column="1"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <ui:SymbolIcon
                                                    Width="18"
                                                    Height="18"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="18"
                                                    Foreground="#94A3B8"
                                                    Symbol="DocumentOnePage24" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    FontWeight="Normal"
                                                    Foreground="#172033"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Border
                                                    Height="32"
                                                    Padding="8,0"
                                                    VerticalAlignment="Center"
                                                    Background="#FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    SnapsToDevicePixels="True">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasEditError}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="#DC2626" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBox
                                                        Height="30"
                                                        Padding="0"
                                                        VerticalContentAlignment="Center"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        CaretBrush="#64748B"
                                                        FontSize="14"
                                                        Foreground="#172033"
                                                        Text="{Binding Name, Mode=OneWay}"
                                                        Loaded="RenameBox_Loaded"
                                                        TextChanged="RenameBox_TextChanged"
                                                        PreviewKeyDown="RenameBox_PreviewKeyDown"
                                                        LostFocus="RenameBox_LostFocus" />
                                                </Border>
                                                <TextBlock
                                                    Margin="0,4,0,0"
                                                    FontSize="12"
                                                    Foreground="#DC2626"
                                                    Text="{Binding EditError}"
                                                    TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasEditError}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="Normal"
                                            Foreground="#94A3B8"
                                            Text="{Binding FieldsText}" />
                                        <TextBlock
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="Normal"
                                            Foreground="#94A3B8"
                                            Text="{Binding AnchorsText}" />
                                        <TextBlock
                                            Grid.Column="4"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="Normal"
                                            Foreground="#94A3B8"
                                            Text="{Binding LastModifiedText}" />

                                        <ui:Button
                                            Grid.Column="5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource TemplatesRowMoreButtonStyle}"
                                            ToolTip="{x:Static res:Strings.ToolTip_More}"
                                            Click="RowMore_Click">
                                            <ui:SymbolIcon
                                                FontSize="16"
                                                Symbol="MoreVertical24"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                                        </ui:Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel
                    x:Name="EmptyStatePanel"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="EmptyStateTitle"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#0F172A"
                        Text="{x:Static res:Strings.Templates_EmptyTitle}" />
                    <TextBlock
                        x:Name="EmptyStateDetail"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        FontWeight="Normal"
                        Foreground="#94A3B8"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Text="{x:Static res:Strings.Templates_EmptyDetail}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 操作结果 toast：浮于列表区顶端、同宽；高 Z，不挤占布局 -->
        <Border
            x:Name="StatusBanner"
            Grid.Row="2"
            Margin="0,20,0,0"
            Padding="14,12"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Panel.ZIndex="200"
            CornerRadius="8"
            Visibility="Collapsed"
            SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="16"
                    Direction="270"
                    Opacity="0.14"
                    ShadowDepth="3"
                    Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon
                    x:Name="StatusBannerIcon"
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Top"
                    FontSize="18"
                    Symbol="Info24" />
                <TextBlock
                    x:Name="StatusBannerText"
                    Grid.Column="1"
                    Margin="0,1,8,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    LineHeight="20"
                    TextWrapping="Wrap" />
                <ui:Button
                    Grid.Column="2"
                    Width="28"
                    Height="28"
                    Padding="0"
                    VerticalAlignment="Top"
                    Appearance="Transparent"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="StatusBannerClose_Click">
                    <ui:SymbolIcon FontSize="12" Symbol="Dismiss24" />
                </ui:Button>
            </Grid>
        </Border>

        <!-- 底部提示条：本地存储说明 -->
        <Border
            Grid.Row="3"
            Margin="0,30,0,10"
            Padding="12,10"
            Background="#F8FAFC"
            BorderBrush="#EEF2F7"
            BorderThickness="1"
            CornerRadius="8"
            HorizontalAlignment="Stretch">
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center">
                <ui:SymbolIcon
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="#64748B"
                    Symbol="Info24" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="Normal"
                    Foreground="#94A3B8"
                    TextWrapping="Wrap"
                    Text="{x:Static res:Strings.Templates_Footer}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
